# ============================================================================
# Environment variables for the API Gateway backend.
# ============================================================================
#
# Spring Boot does NOT read this file. Set each variable as a PowerShell
# environment variable in the SAME window you run mvnw.cmd from:
#
#   $env:DB_URL="jdbc:mysql://<host>:<port>/<database>?sslMode=REQUIRED&serverTimezone=UTC"
#   $env:DB_USERNAME="avnadmin"
#   $env:DB_PASSWORD="<your Aiven password>"
#   $env:JWT_SECRET="<at least 32 bytes>"
#   $env:CORS_ALLOWED_ORIGIN="http://localhost:5173"
#   $env:GATEWAY_ALLOW_PRIVATE_UPSTREAMS="false"
#
# Then:  cd backend ; .\mvnw.cmd clean spring-boot:run
#
# These $env: variables live only in that PowerShell session. To set them
# permanently for your user:
#   [Environment]::SetEnvironmentVariable("DB_URL","...","User")
# then open a new window.
#
# This file lists VARIABLE NAMES AND FORMATS ONLY. Never put real secrets here
# and never commit real values.
# ============================================================================

# --- Database (Aiven MySQL requires SSL). Get host/port/database/user/password
#     from the Aiven console -> "Connection information". ---
DB_URL=jdbc:mysql://<host>:<port>/<database>?sslMode=REQUIRED&serverTimezone=UTC
DB_USERNAME=
DB_PASSWORD=

# --- JWT signing secret (HS256). MUST be at least 32 bytes. Generate with:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=

# --- CORS: the frontend origin (Vite dev server defaults to http://localhost:5173). ---
CORS_ALLOWED_ORIGIN=http://localhost:5173

# --- SSRF: keep "false" in production. Set "true" ONLY for local dev when the
#     upstream API itself lives on a private/loopback address. ---
GATEWAY_ALLOW_PRIVATE_UPSTREAMS=false
